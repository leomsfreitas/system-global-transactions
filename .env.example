# Copie para .env (make up faz isso se .env nao existir). Valores apenas para desenvolvimento local.
# Nunca coloque segredos reais aqui: na AWS tudo vem do Secrets Manager.

# PostgreSQL local: dono (migrations), API e worker
DB_SENHA_OWNER=troque-local-owner
DB_SENHA_API=troque-local-api
DB_SENHA_WORKER=troque-local-worker

# Hashes SHA-256 das chaves aceitas pela API, separados por virgula.
# Este e o hash da chave de exemplo "chave-local-de-exemplo" (gerar outro: printf 'minha-chave' | shasum -a 256)
API_KEYS_SHA256=941f6c003166e9b91f9fa29062dff91189314c7cec26e03af4af16d933d9a1a1
